#include <winres.h>
#include "../src/resource.h"
#include "../src/version.h"

// アプリケーションアイコン (タスクバー・タイトルバー・エクスプローラー)
IDI_APPICON ICON "ChordLaunch.ico"

// バージョン情報: 定義元は src\version.h (プレリリース)
VS_VERSION_INFO VERSIONINFO
 FILEVERSION CHORDLAUNCH_VER_MAJOR,CHORDLAUNCH_VER_MINOR,0,0
 PRODUCTVERSION CHORDLAUNCH_VER_MAJOR,CHORDLAUNCH_VER_MINOR,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRERELEASE
#else
 FILEFLAGS VS_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "stellorbit"
            VALUE "FileDescription", "ChordLaunch - Chord progression tool"
            VALUE "FileVersion", CHORDLAUNCH_FILEVERSION_STR
            VALUE "InternalName", "ChordLaunch"
            VALUE "LegalCopyright", "Copyright (C) stellorbit"
            VALUE "OriginalFilename", "ChordLaunch.exe"
            VALUE "ProductName", "ChordLaunch"
            VALUE "ProductVersion", CHORDLAUNCH_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
